{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "book-info values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "registry": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["registry", "tag"]
    },
    "services": {
      "type": "object"
    }
  },
  "required": ["image", "services"]
}
